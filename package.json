{
  "name": "info-gap-radar",
  "version": "0.4.0",
  "private": true,
  "description": "Desktop MVP for discovering global hot topics and AI-generated insight reports.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "electron:dev": "node scripts/dev.mjs",
    "build:web": "vite build",
    "build:desktop": "electron-builder",
    "backend:test": "cd backend && .venv/Scripts/python.exe -m pytest tests -q",
    "lint": "npm run build:web"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "dompurify": "^3.4.13",
    "electron-store": "^8.2.0",
    "highlight.js": "^11.12.0",
    "lucide-vue-next": "^0.468.0",
    "marked": "^18.0.9",
    "vite": "^6.0.3",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.infogap.radar",
    "productName": "信息差雷达",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend/dist",
        "to": "backend/dist",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.news"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  }
}
